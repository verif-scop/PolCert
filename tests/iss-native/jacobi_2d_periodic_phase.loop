context(T, N);
for q in range(0, T) {
  for p in range(0, 2) {
    if (((2 * q) + p + 1) <= (T - 1)) {
      for i in range(0, N) {
        for j in range(0, N) {
          u[(1 - p)][i][j] =
            ((i == 0) ? u[p][(N - 1)][j] : u[p][(i - 1)][j])
            + u[p][i][j]
            + ((i == (N - 1)) ? u[p][0][j] : u[p][(i + 1)][j])
            + ((i == 0)
               ? ((j == 0) ? u[p][(N - 1)][(N - 1)] : u[p][(N - 1)][(j - 1)])
               : ((j == 0) ? u[p][(i - 1)][(N - 1)] : u[p][(i - 1)][(j - 1)]))
            + ((i == (N - 1))
               ? ((j == (N - 1)) ? u[p][0][0] : u[p][0][(j + 1)])
               : ((j == (N - 1)) ? u[p][(i + 1)][0] : u[p][(i + 1)][(j + 1)]));
        }
      }
    }
  }
}
