context(T, N);

for t in range(0, T) {
  for i in range(1, (N + 1)) {
    for j in range(1, (N + 1)) {
      for k in range(1, (N + 1)) {
        new_point[i][j][k] = ((((0.125 * ((point[(i + 1)][j][k] - (2.0 * point[i][j][k])) + point[(i - 1)][j][k])) + (0.125 * ((point[i][(j + 1)][k] - (2.0 * point[i][j][k])) + point[i][(j - 1)][k]))) + (0.125 * ((point[i][j][(k - 1)] - (2.0 * point[i][j][k])) + point[i][j][(k + 1)]))) + point[i][j][k]);
      }
    }
  }
  for i in range(1, (N + 1)) {
    for j in range(1, (N + 1)) {
      for k in range(1, (N + 1)) {
        point[i][j][k] = new_point[i][j][k];
      }
    }
  }
}
