context(NUM_NODES);

for k in range(0, NUM_NODES) {
  for y in range(0, NUM_NODES) {
    for x in range(0, NUM_NODES) {
      pathDistanceMatrix[y][x] = (((pathDistanceMatrix[y][k] + pathDistanceMatrix[k][x]) <= (pathDistanceMatrix[y][x] - 1)) ? (pathDistanceMatrix[y][k] + pathDistanceMatrix[k][x]) : pathDistanceMatrix[y][x]);
    }
  }
}
